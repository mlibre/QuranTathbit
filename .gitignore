# Godot 4+ specific ignores
.godot/
/android/

# Only written if you run godot --dump-extension-api yourself (it always dumps
# to the current folder); 6.7MB of engine reference data nothing here reads.
# Run it from a scratch folder outside the project if you ever need one.
extension_api.json
builds/
android/
keystores/
.godot/export_credentials.cfg

# The 12 MB source package lives on the developer's machine, not in the
# repo. tools/verify_deck.py proves the deck is byte-identical to it when
# it is present, and prints a clean "skip" when it is not.
quran-cards-2026-10-14.apkg

# Node / npm locals: package.json and start.js ARE committed (they ARE the
# package), but anything npm pulls or builds locally is not.
node_modules/
npm-debug.log*
.npm/
