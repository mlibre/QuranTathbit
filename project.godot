; QuranTathbit — native Godot 4.7 project
; Engine configuration. The app is pure 2D interface built in code at
; runtime: no external scenes, textures or models — just the fonts and
; the deck it ships with.

config_version=5

[application]

config/name="QuranTathbit"
config/description="A quiet companion for keeping the Qur'an close — one deck, kept as folders and files."
; The phone's back key is a page's way back, not the app's way out: with
; this off, the engine hands the key to the app (main.gd answers it the
; way every page answers Esc) instead of quitting on the spot.
config/quit_on_go_back=false
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.98, 0.96, 0.93, 1)
boot_splash/show_image=false
config/icon="res://assets/icons/icon.svg"

[display]

; The app is built to be held as readily as it is run on a desktop. The
; base canvas is the phone: 420 wide, 800 tall. With the expand aspect the
; engine pins the design canvas at the base's own width for any window
; narrower than the base's aspect -- a phone -- and at the base's height
; for any window wider -- a desktop -- so a hand gets a hand's layout at a
; hand's scale, and a desk keeps the 1280x800 window it has always had,
; pixel for pixel. A desktop base here would pin the canvas at 1280 wide
; on a phone instead, drawing the whole desktop UI at a third of its size.
window/size/viewport_width=420
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
; The page behind the cards: the theme's warm paper, so the voids around the
; centred column read as the page and not as a dark screen.
environment/defaults/default_clear_color=Color(0.980392, 0.964706, 0.929412, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
; 2D MSAA is not supported by the GLES3 driver and only prints a warning on
; every launch (the web build included); this interface is text, not geometry.
anti_aliasing/quality/msaa_2d=0

[input_devices]

pointing/emulate_touch_from_mouse=true
